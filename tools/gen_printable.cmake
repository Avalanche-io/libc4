# Generates src/c4m/printable_table.inc, the table SafeName's Tier 1 test
# reads, from the shared table every C4 implementation embeds:
# tests/testdata/safename-vector/printable-17.0.0.txt (a byte-for-byte copy
# of c4's c4m/testdata/safename-vector/printable-17.0.0.txt). It is Go's
# unicode.IsPrint at Unicode 17.0.0, one inclusive hex range per line.
#
# Run from the repository root after updating the text file:
#   cmake -DTABLE=tests/testdata/safename-vector/printable-17.0.0.txt \
#         -DOUT=src/c4m/printable_table.inc -P tools/gen_printable.cmake
# The test printable_table_generated runs it into the build tree and fails
# if the checked-in file differs.
cmake_minimum_required(VERSION 3.16)

if(NOT DEFINED TABLE OR NOT DEFINED OUT)
  message(FATAL_ERROR "usage: cmake -DTABLE=<printable-X.Y.Z.txt> -DOUT=<file.inc> -P gen_printable.cmake")
endif()

get_filename_component(table_name "${TABLE}" NAME)
if(NOT table_name MATCHES "^printable-([0-9]+\\.[0-9]+\\.[0-9]+)\\.txt$")
  message(FATAL_ERROR "${TABLE}: expected a file named printable-<unicode version>.txt")
endif()
set(version "${CMAKE_MATCH_1}")

file(STRINGS "${TABLE}" lines)
set(body "")
set(count 0)
set(prev_hi -1)
foreach(line ${lines})
  if(line STREQUAL "" OR line MATCHES "^#")
    continue()
  endif()
  if(NOT line MATCHES "^([0-9A-F]+)\\.\\.([0-9A-F]+)$")
    message(FATAL_ERROR "${TABLE}: bad line '${line}'")
  endif()
  set(lo_hex "${CMAKE_MATCH_1}")
  set(hi_hex "${CMAKE_MATCH_2}")
  math(EXPR lo "0x${lo_hex}")
  math(EXPR hi "0x${hi_hex}")
  # Sorted and disjoint, as the lookup's binary search requires.
  if(lo GREATER hi OR NOT lo GREATER prev_hi)
    message(FATAL_ERROR "${TABLE}: range ${lo_hex}..${hi_hex} is not sorted and disjoint")
  endif()
  set(prev_hi ${hi})
  string(APPEND body "    {0x${lo_hex}, 0x${hi_hex}},\n")
  math(EXPR count "${count} + 1")
endforeach()

file(WRITE "${OUT}"
"// SPDX-License-Identifier: Apache-2.0
// Generated by tools/gen_printable.cmake from
// tests/testdata/safename-vector/${table_name}. Do not edit.
//
// SafeName's printable code points: Go unicode.IsPrint at Unicode ${version}
// (letters, marks, numbers, punctuation, symbols, and U+0020), as sorted,
// disjoint, inclusive ranges. ${count} ranges.
#define C4M_PRINTABLE_UNICODE_VERSION \"${version}\"
${body}")
